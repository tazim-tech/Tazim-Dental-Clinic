# Copy to .env and fill in. Never commit .env.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=change-me
# Optional. When set, webhook posts must carry a valid X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v25.0
CLINIC_ID=grin-glow
PORT=8787
# Set to 1 to log outbound WhatsApp calls instead of sending them.
WHATSAPP_DRY_RUN=0
REMINDER_POLL_MS=30000
